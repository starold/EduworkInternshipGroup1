    </tr>
    <tr><td><code>id</code></td><td>BIGINT (PK, Auto Inc)</td><td>Identifikator unik motor</td></tr>
    <tr><td><code>motor_category_id</code></td><td>BIGINT (FK)</td><td>Relasi ke tabel <code>motor_categories</code></td></tr>
    <tr><td><code>merk</code></td><td>VARCHAR(100)</td><td>Brand produsen motor (Honda, Yamaha, Suzuki)</td></tr>
    <tr><td><code>model</code></td><td>VARCHAR(100)</td><td>Varian model motor (Genio, Beat, NMAX, Aerox)</td></tr>
