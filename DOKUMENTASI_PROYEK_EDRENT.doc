    <tr><td><code>warna</code></td><td>VARCHAR(50)</td><td>Warna bodi kendaraan</td></tr>
    <tr><td><code>year</code></td><td>INT</td><td>Tahun perakitan/pembuatan kendaraan</td></tr>
    <tr><td><code>price_per_day</code></td><td>DECIMAL(12,2)</td><td>Tarif harga sewa per 24 jam</td></tr>
    <tr><td><code>deposit</code></td><td>DECIMAL(12,2)</td><td>Nominal jaminan / deposit awal sewa</td></tr>
    <tr><td><code>status</code></td><td>ENUM('available', 'rented', 'maintenance')</td><td>Status ketersediaan armada</td></tr>
    <tr><td><code>image</code></td><td>VARCHAR(255) (Nullable)</td><td>Foto unit motor</td></tr>
    <tr><td><code>description</code></td><td>TEXT (Nullable)</td><td>Deskripsi fitur, kapasitas mesin, dan keunggulan unit</td></tr>
</table>

